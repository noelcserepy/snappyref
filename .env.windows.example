# Copy to .env.windows and fill with private local values.
# .env.windows is gitignored. Use your own SSH config aliases.

SNAPPYREF_WINDOWS_HOST='<windows-ssh-host>'
SNAPPYREF_WINDOWS_REPO='<absolute-windows-checkout-path>'

# Optional wake setup. The relay must be awake, have python3, and reach the
# sleeping PC's local network broadcast domain.
SNAPPYREF_WINDOWS_WAKE_RELAY='<wake-relay-ssh-host>'
SNAPPYREF_WINDOWS_MAC='<pc-mac-address>'
# Optional overrides. Put a subnet broadcast address here when needed.
# SNAPPYREF_WINDOWS_WAKE_BROADCAST='<ipv4-broadcast-address>'
# SNAPPYREF_WINDOWS_WAKE_TIMEOUT_SECONDS=120
