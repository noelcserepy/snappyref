#!/usr/bin/env bash
# Local checks before the push. Commands are owned by AGENTS.md.
# Bypass with `git push --no-verify` if you mean it.
#
# Setup: README.md#development-checks

set -euo pipefail

# A push that only deletes remote refs (local sha all zeros) carries no code,
# and neither does a code-free branch such as pr-assets.
[[ -f Cargo.toml ]] || exit 0
pushes_code=0
while read -r _ local_sha _ _; do
  [[ "$local_sha" =~ ^0+$ ]] || pushes_code=1
done
(( pushes_code )) || exit 0

# Git exports GIT_DIR and friends to hooks. A check that runs `git init` in a
# scratch directory would otherwise write to the pushing repository's config.
unset $(git rev-parse --local-env-vars)

# A passing check prints only its name, so a reader of a passing push sees one
# line per check. A failing check prints everything it wrote.
check() {
  echo "[pre-push] $*"
  local output
  if ! output=$("$@" 2>&1); then
    printf '%s\n' "$output"
    exit 1
  fi
}

check cargo fmt --check
check cargo clippy --quiet --locked --all-targets -- -D warnings
check cargo test --quiet --locked
check python3 -m unittest discover --buffer -s scripts -p 'test_*.py'

echo "[pre-push] ok"
