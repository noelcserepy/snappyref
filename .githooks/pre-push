#!/usr/bin/env bash
# Local lint before the push: formatting and clippy. CI is switched off, so run
# `cargo test --locked` yourself. Bypass with `git push --no-verify` if you mean it.
#
# Setup: README.md#development-checks

set -euo pipefail

# A push that only deletes remote refs (local sha all zeros) carries no code,
# and neither does a code-free branch such as pr-assets.
[[ -f Cargo.toml ]] || exit 0
pushes_code=0
while read -r _ local_sha _ _; do
  [[ "$local_sha" =~ ^0+$ ]] || pushes_code=1
done
(( pushes_code )) || exit 0

echo "[pre-push] cargo fmt --check"
cargo fmt --check

echo "[pre-push] cargo clippy --locked --all-targets -- -D warnings"
cargo clippy --locked --all-targets -- -D warnings

echo "[pre-push] ok"
