#!/usr/bin/env bash
# Local checks before the push. Commands are owned by AGENTS.md.
# Bypass with `git push --no-verify` if you mean it.
#
# Setup: README.md#development-checks

set -euo pipefail

# A push that only deletes remote refs (local sha all zeros) carries no code,
# and neither does a code-free branch such as pr-assets.
[[ -f Cargo.toml ]] || exit 0
pushes_code=0
while read -r _ local_sha _ _; do
  [[ "$local_sha" =~ ^0+$ ]] || pushes_code=1
done
(( pushes_code )) || exit 0

# Git exports repository variables such as GIT_DIR to hooks. Tests that run git
# in a scratch repo would otherwise act on this one: in a worktree, `git init`
# then sets core.bare=true in the shared config and breaks every checkout.
unset $(git rev-parse --local-env-vars)

echo "[pre-push] cargo fmt --check"
cargo fmt --check

echo "[pre-push] cargo clippy --locked --all-targets -- -D warnings"
cargo clippy --locked --all-targets -- -D warnings

echo "[pre-push] cargo test --locked"
cargo test --locked

echo "[pre-push] Python script tests"
python3 -m unittest discover -s scripts -p 'test_*.py'

echo "[pre-push] ok"
