#!/usr/bin/env bash
# Local pre-push checks: formatting, shipping-feature compilation, and update
# preservation. Bypass with `git push --no-verify` if you really mean it.
#
# One-time setup on a fresh clone:
#   git config core.hooksPath .githooks

set -euo pipefail

echo "[pre-push] cargo fmt --check"
cargo fmt --check

echo "[pre-push] cargo check --locked"
cargo check --locked

echo "[pre-push] cargo test update_preservation_smoke"
cargo test --locked update_preservation_smoke

echo "[pre-push] ok"
