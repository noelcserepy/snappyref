#!/usr/bin/env bash
# Local checks before the push. Commands are owned by AGENTS.md.
# Bypass with `git push --no-verify` if you mean it.
#
# Setup: README.md#development-checks

set -euo pipefail

refs="$(cat)"

# Every push, pr-assets included, since the repo is public.
if [[ -f scripts/check-private-values.py ]]; then
  echo "[pre-push] private values"
  python3 scripts/check-private-values.py <<<"$refs"
fi

# A push that only deletes remote refs (local sha all zeros) carries no code,
# and neither does a code-free branch such as pr-assets.
[[ -f Cargo.toml ]] || exit 0
pushes_code=0
while read -r _ local_sha _ _; do
  [[ -z "$local_sha" || "$local_sha" =~ ^0+$ ]] || pushes_code=1
done <<<"$refs"
(( pushes_code )) || exit 0

# Git exports GIT_DIR and friends to hooks. A check that runs `git init` in a
# scratch directory would otherwise write to the pushing repository's config.
unset $(git rev-parse --local-env-vars)

echo "[pre-push] cargo fmt --check"
cargo fmt --check

echo "[pre-push] cargo clippy --locked --all-targets -- -D warnings"
cargo clippy --locked --all-targets -- -D warnings

echo "[pre-push] cargo test --locked"
cargo test --locked

echo "[pre-push] Python script tests"
python3 -m unittest discover -s scripts -p 'test_*.py'

echo "[pre-push] ok"
